# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional additional AI providers (configure on the server / .env):
# OpenAI (supports gpt-4o, gpt-4o-mini, gpt-4.1, etc.)
OPENAI_API_KEY=""

# Anthropic Claude (supports claude-sonnet-4-20250514, claude-3-5-haiku-latest, etc.)
ANTHROPIC_API_KEY=""

# DeepSeek (supports deepseek-chat, deepseek-reasoner for Text-to-Wireframe)
DEEPSEEK_API_KEY=""

# Local / OpenAI-Compatible (Ollama, LM Studio, vLLM, Groq, OpenRouter, etc.)
# Example for local Ollama: OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_BASE_URL=""
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
